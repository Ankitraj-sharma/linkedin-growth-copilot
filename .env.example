# ==============================================================================
# LinkedIn Growth Copilot - Environment Configuration Template
# ==============================================================================

# 1. Supabase Database Configuration
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# 3. LinkedIn Session Authentication (Safe Cookie Method)
# Extract the 'li_at' cookie from your browser after logging in manually to avoid storing raw passwords
LINKEDIN_LI_AT_COOKIE=your-li_at-cookie-value
LINKEDIN_JSESSIONID=your-jsessionid-value

# 4. Human-Mimic Safety & Rate Limiting Controls
# Strict defaults designed to prevent LinkedIn anti-bot detection
MAX_DAILY_CONNECTIONS=15
MAX_DAILY_MESSAGES=25
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=130
TYPING_SPEED_MIN_MS=50
TYPING_SPEED_MAX_MS=180
WORKING_HOURS_START=9
WORKING_HOURS_END=19
TIMEZONE=Asia/Kolkata

# 5. Application Server
PORT=3000
NODE_ENV=development
